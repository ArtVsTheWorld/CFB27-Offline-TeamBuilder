* text=auto
# Preserve the exact runtime source/profile bytes for reproducible builds.
runtime/** -text whitespace=blank-at-eol,cr-at-eol
runtime/src/** -text whitespace=blank-at-eol,cr-at-eol
runtime/Profiles/** -text whitespace=blank-at-eol,cr-at-eol
runtime/Native/** -text whitespace=blank-at-eol,cr-at-eol
assets/compatibility/** -text whitespace=blank-at-eol,cr-at-eol
*.dll -text
*.fbmod -text
*.fbproject -text
*.zip -text
